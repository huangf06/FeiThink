---
import type { Language } from '@/i18n/config'
import { moreLocales, themeConfig } from '@/config'
import { getNextGlobalLang } from '@/i18n/lang'
import { getLocalizedPath, getNextGlobalLangPath, getNextSupportedLangPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'
import Wordmark from './Wordmark.astro'

interface Props {
  supportedLangs?: Language[]
}

const { supportedLangs = [] } = Astro.props
const currentPath = Astro.url.pathname
const { currentLang, isHome, isPost, isEssays, isMoments, isAbout, isWork } = getPageInfo(currentPath)
const t = ui[currentLang] ?? ui.en

const {
  light: { background: lightMode },
  dark: { background: darkMode },
} = themeConfig.color

// Language switcher target + label (shows the other language).
// Essays index, line pages and Work are English-only routes — switching
// language there has no localized counterpart, so fall back to the other
// language's home instead of a 404.
const showLanguageSwitcher = moreLocales.length > 0
const enOnlyRoute = (isEssays && !isPost) || isWork
const nextUrl = enOnlyRoute
  ? getLocalizedPath('/', getNextGlobalLang(currentLang))
  : supportedLangs.length > 0
    ? getNextSupportedLangPath(currentPath, supportedLangs)
    : getNextGlobalLangPath(currentPath)
const langLabel = currentLang.startsWith('zh') ? 'EN' : '中文'

const navItems = [
  { label: t.home, href: getLocalizedPath('/', currentLang), active: isHome },
  { label: t.essays, href: '/essays/', active: isEssays || isPost },
  { label: t.moments, href: getLocalizedPath('/moments/', currentLang), active: isMoments },
  { label: t.about, href: getLocalizedPath('/about/', currentLang), active: isAbout },
]

function navClass(active: boolean) {
  return active
    ? 'highlight-static c-primary'
    : 'highlight-hover c-secondary hover:c-primary'
}
---

<header class="sticky top-0 z-40 border-b border-secondary/5 border-solid bg-background">
  <input id="nav-drawer" type="checkbox" class="peer hidden" aria-hidden="true" />

  <div class="mx-auto h-16.8 max-w-60rem flex items-center justify-between px-[clamp(1.2rem,4vw,2.5rem)]">
    <a id="site-title-link" href={getLocalizedPath('/')} class="no-underline" aria-label={themeConfig.site.title}>
      <Wordmark class="text-[1.6rem]" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-5.6 text-[1.05rem] font-navbar min-[680px]:flex" aria-label="Site Navigation">
      {navItems.map(item => (
        <a href={item.href} class:list={['italic no-underline transition-colors', navClass(item.active)]}>{item.label}</a>
      ))}
      <span class="c-secondary/15" aria-hidden="true">·</span>
      {showLanguageSwitcher && (
        <a
          id="language-switcher"
          href={nextUrl}
          class="text-3 c-secondary tracking-wide font-mono no-underline transition-colors active:scale-90 hover:c-primary"
          aria-label="Switch language"
        >{langLabel}</a>
      )}
      <button
        type="button"
        class="theme-toggle-button text-[1.05rem] c-secondary leading-none transition-colors active:scale-90 hover:c-primary"
        data-light-mode={lightMode}
        data-dark-mode={darkMode}
        aria-label="Switch light/dark theme"
        id="theme-toggle-button"
      >
        <span class="icon-moon" aria-hidden="true">☽</span>
        <span class="icon-sun" aria-hidden="true">☼</span>
      </button>
    </nav>

    <!-- Mobile hamburger -->
    <label for="nav-drawer" class="flex flex-col cursor-pointer gap-1.2 p-1.5 min-[680px]:hidden" aria-label="Open menu">
      <span class="block h-[1.5px] w-5.5 bg-primary"></span>
      <span class="block h-[1.5px] w-5.5 bg-primary"></span>
      <span class="block h-[1.5px] w-5.5 bg-primary"></span>
    </label>
  </div>

  <!-- Mobile drawer -->
  <div class="fixed inset-0 z-60 hidden peer-checked:block min-[680px]:hidden">
    <label for="nav-drawer" class="absolute inset-0 bg-background/96" aria-label="Close menu"></label>
    <div class="relative h-full flex flex-col px-[clamp(1.2rem,4vw,2.5rem)]">
      <div class="h-16.8 flex items-center justify-between">
        <Wordmark class="text-[1.6rem]" />
        <label for="nav-drawer" class="cursor-pointer text-7 c-secondary leading-none" aria-label="Close menu">×</label>
      </div>
      <nav class="mt-8 flex flex-col gap-1 text-[1.6rem] font-navbar" aria-label="Site Navigation">
        {navItems.map(item => (
          <a href={item.href} class:list={['inline-block w-fit py-1.5 italic no-underline transition-colors', navClass(item.active)]}>{item.label}</a>
        ))}
      </nav>
      <div class="mt-auto flex items-center gap-6 border-t border-secondary/5 border-solid pb-10 pt-8">
        {showLanguageSwitcher && (
          <a href={nextUrl} class="text-3.4 c-secondary tracking-wide font-mono no-underline hover:c-primary" aria-label="Switch language">{langLabel}</a>
        )}
        <button
          type="button"
          class="theme-toggle-button text-5 c-secondary leading-none active:scale-90 hover:c-primary"
          data-light-mode={lightMode}
          data-dark-mode={darkMode}
          aria-label="Switch light/dark theme"
        >
          <span class="icon-moon" aria-hidden="true">☽</span>
          <span class="icon-sun" aria-hidden="true">☼</span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Theme Toggle Script (relocated from the retypeset Button component) -->
<script>
function applyTheme(isDark: boolean) {
  document.documentElement.classList.toggle('dark', isDark)

  const metaThemeColor = document.head.querySelector('meta[name="theme-color"]')
  const themeButton = document.getElementById('theme-toggle-button')
  const lightMode = themeButton?.dataset.lightMode
  const darkMode = themeButton?.dataset.darkMode

  if (metaThemeColor && lightMode && darkMode) {
    metaThemeColor.setAttribute('content', isDark ? darkMode : lightMode)
  }

  localStorage.setItem('theme', isDark ? 'dark' : 'light')
  document.dispatchEvent(new Event('theme-changed'))
}

function toggleTheme() {
  const isDark = !document.documentElement.classList.contains('dark')
  applyTheme(isDark)
}

function handleThemeToggle(e: MouseEvent) {
  if (!(e.target instanceof Element)) {
    return
  }

  if (!e.target.closest('.theme-toggle-button')) {
    return
  }

  // Close the mobile drawer if open
  const drawer = document.getElementById('nav-drawer') as HTMLInputElement | null
  if (drawer) {
    drawer.checked = false
  }

  if (document.documentElement.classList.contains('reduce-motion') || !('startViewTransition' in document)) {
    toggleTheme()
    return
  }

  document.documentElement.style.setProperty('view-transition-name', 'theme-toggle-transition')
  document.documentElement.setAttribute('data-theme-changing', '')

  const transition = document.startViewTransition(toggleTheme)
  transition.finished.then(() => {
    document.documentElement.style.removeProperty('view-transition-name')
    document.documentElement.removeAttribute('data-theme-changing')
  })
}

function handleSystemChange(event: MediaQueryListEvent) {
  applyTheme(event.matches)
}

document.addEventListener('click', handleThemeToggle)
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', handleSystemChange)
</script>
