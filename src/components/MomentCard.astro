---
import type { Language } from '@/i18n/config'
import type { Post } from '@/types'
import PostMeta from '@/components/PostMeta.astro'
import { defaultLocale } from '@/config'

interface Props {
  moment: Post
  variant?: 'home' | 'index'
  lang: Language
}

const { moment, lang } = Astro.props
const slug = moment.data.abbrlink || moment.id
const href = lang === defaultLocale
  ? `/moments/${slug}/`
  : `/${lang}/moments/${slug}/`

const cover = moment.data.image ?? moment.data.images?.[0]
---

<a
  href={href}
  class="group block overflow-hidden border border-secondary/5 rounded border-solid bg-background no-underline transition-colors hover:border-secondary/15"
>
  {cover && (
    <div class="overflow-hidden bg-secondary/10" style="aspect-ratio:3 / 2">
      <img
        src={cover}
        alt=""
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
        style="filter:grayscale(1) contrast(1.05)"
      />
    </div>
  )}
  <div class="px-4.4 pb-4.6 pt-4">
    <PostMeta date={moment.data.published} class="mb-1.4" />
    {moment.data.title && (
      <h3 class="m-0 mb-1.6 text-4.5 c-primary font-semibold leading-[1.35] font-serif cjk:tracking-wide">
        {moment.data.title}
      </h3>
    )}
    {moment.data.description && (
      <p class="line-clamp-3 m-0 text-3.6 c-secondary leading-[1.6] font-serif">
        {moment.data.description}
      </p>
    )}
  </div>
</a>
