---
import EssayRow from '@/components/EssayRow.astro'
import Tag from '@/components/Tag.astro'
import { LINES } from '@/data/lines'
import Layout from '@/layouts/Layout.astro'
import { getEssays } from '@/utils/content'

const essays = await getEssays('en')
---

<Layout postTitle="Essays">
  <div class="pt-[clamp(2rem,5vw,3.5rem)]">
    <header class="mb-[clamp(1.5rem,4vw,2.2rem)]">
      <h1 class="m-0 mb-[clamp(1rem,3vw,1.3rem)] text-[clamp(2.125rem,7vw,3.25rem)] c-primary font-bold leading-tight font-serif">
        Essays
      </h1>
      <div class="flex flex-wrap gap-2.2">
        <Tag active href="/essays/">All</Tag>
        {LINES.map(line => (
          <Tag href={`/essays/lines/${line.slug}/`}>{line.title}</Tag>
        ))}
      </div>
    </header>

    <div>
      {essays.map(essay => <EssayRow essay={essay} lang="en" />)}
    </div>
  </div>
</Layout>
