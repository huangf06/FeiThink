---
import type { CollectionEntry } from 'astro:content'
import type { Language } from '@/i18n/config'
import { getCollection, render } from 'astro:content'
import AuthorCard from '@/components/AuthorCard.astro'
import Comment from '@/components/Comment/Index.astro'
import Photo from '@/components/Photo.astro'
import PostMeta from '@/components/PostMeta.astro'
import Tag from '@/components/Tag.astro'
import TagList from '@/components/TagList.astro'
import { allLocales } from '@/config'
import { getLineTitle } from '@/data/lines'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getLocalizedPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { checkPostSlugDuplication } from '@/utils/content'
import { getPostDescription } from '@/utils/description'

export async function getStaticPaths() {
  const posts: CollectionEntry<'posts'>[] = await getCollection('posts')

  // Check if there are duplicate post slugs
  const duplicates = await checkPostSlugDuplication(posts)
  if (duplicates.length > 0) {
    throw new Error(`Duplicate post slugs:\n${duplicates.join('\n')}`)
  }

  // Build a map of post slugs to their supported languages
  // Handles both specific language posts (e.g., 'en') and universal posts (lang: '')
  const slugToLangsMap = new Map<string, Set<Language>>()

  for (const post of posts) {
    const slug = post.data.abbrlink || post.id
    const lang = post.data.lang

    let langSet = slugToLangsMap.get(slug)
    if (!langSet) {
      langSet = new Set()
      slugToLangsMap.set(slug, langSet)
    }

    if (lang) {
      langSet.add(lang as Language)
    }
    else {
      allLocales.forEach(locale => langSet.add(locale))
    }
  }

  // Convert the map to a sorted record for the component props
  const slugToLangs: Record<string, Language[]> = {}
  for (const [slug, langs] of slugToLangsMap) {
    slugToLangs[slug] = [...langs].sort((a, b) => allLocales.indexOf(a) - allLocales.indexOf(b))
  }

  return allLocales.flatMap(lang => posts
    // Show drafts in dev mode only
    .filter(post => import.meta.env.DEV || !post.data.draft)
    // Match current language or universal posts
    .filter(post => post.data.lang === lang || post.data.lang === '')
    .map((post) => {
      const slug = post.data.abbrlink || post.id
      return {
        params: { lang: getLangRouteParam(lang), slug },
        props: { post, supportedLangs: slugToLangs[slug] },
      }
    }),
  )
}

interface Props {
  post: CollectionEntry<'posts'>
  supportedLangs: Language[]
}

const { post, supportedLangs } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const t = ui[currentLang] ?? ui.en
const slug = post.data.abbrlink || post.id
const description = getPostDescription(post, 'meta')
const { Content, remarkPluginFrontmatter } = await render(post)

const line = getLineTitle(post.data.line)
const dek = post.data.description
const image = post.data.image
const langLabel = currentLang.slice(0, 2).toUpperCase()
const aboutHref = getLocalizedPath('/about/', currentLang)
const transitionSuffix = currentLang ? `-${currentLang}` : ''
---

<Layout
  postTitle={post.data.title}
  postDescription={description}
  postSlug={post.id}
  supportedLangs={supportedLangs}
>
  <article class="pt-[clamp(1.5rem,4vw,2.5rem)] font-serif">
    <a
      href="/essays/"
      class="mb-[clamp(1.5rem,4vw,2.2rem)] inline-block c-secondary font-serif italic no-underline transition-colors hover:c-primary"
    >
      {t.backToEssays ?? '← Essays'}
    </a>

    {/* Title block — centered, generous */}
    <header class="mx-auto mb-[clamp(2rem,5vw,3rem)] max-w-40rem text-center">
      {line && (
        <div class="mb-4 flex justify-center">
          <Tag size="sm">{line}</Tag>
        </div>
      )}
      <h1 class="m-0 mb-4 text-balance text-[clamp(2.125rem,6vw,3.75rem)] c-primary font-bold leading-[1.12] font-serif cjk:tracking-wide">
        <span
          transition:name={`post-${slug}${transitionSuffix}`}
          data-disable-theme-toggle-transition
        >
          {post.data.title}
        </span>
      </h1>
      {dek && (
        <p class="mx-auto mb-5 max-w-34rem text-pretty text-[clamp(1.0625rem,2.6vw,1.3125rem)] c-secondary leading-[1.5] font-serif italic">
          {dek}
        </p>
      )}
      <div class="flex justify-center">
        <PostMeta date={post.data.published} minutes={remarkPluginFrontmatter.minutes} lang={langLabel} />
      </div>
    </header>

    {/* Lead image — only when the essay carries one */}
    {image && (
      <div class="mx-auto mb-[clamp(2rem,5vw,3rem)] max-w-46rem">
        <Photo src={image} ratio="16 / 9" />
      </div>
    )}

    {/* Body */}
    <div id="post-content" class="heti mx-auto max-w-34rem">
      <Content />
      <div id="post-copyright" />
      {post.data.tags?.length > 0 && (
        <>
          <div class="mt-12.6 uno-decorative-line" />
          <TagList tags={post.data.tags} lang={currentLang} />
        </>
      )}
      <Comment />
    </div>

    {/* Author card */}
    <div class="mx-auto max-w-34rem">
      <AuthorCard lang={currentLang} aboutHref={aboutHref} />
    </div>
  </article>
</Layout>
